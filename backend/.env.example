# Northbridge KYC - backend configuration. Copy to backend/.env and fill in. Never commit .env.
# Generate secrets with:  uv run python -m app.cli gen-secrets

# development | test | production   (test enables the scripted LLM test double; never use it for real data)
APP_ENV=development
PUBLIC_BASE_URL=http://localhost:5173
ALLOWED_ORIGINS=["http://localhost:5173"]

# ---- Database (one database per environment; no automatic SQLite fallback) ----
# Neon (primary): use the pooled URL at runtime and the direct URL for migrations. TLS is enforced for *.neon.tech.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/nbkyc?sslmode=require
MIGRATION_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/nbkyc?sslmode=require
# Local SQLite (explicit development opt-in, run exactly ONE worker):
# DATABASE_URL=sqlite:///./var/dev.db
# ALLOW_SQLITE=true

# ---- Secrets (keep separate from the database and source code) ----
SESSION_SECRET=
ENCRYPTION_KEY=
IDENTITY_HMAC_SECRET=

# ---- Gemini (backend only; never exposed to the browser) ----
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=2

# ---- OCR ----
# Windows example: TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
TESSERACT_LANG=eng
OCR_TIMEOUT_SECONDS=30

# ---- Upload limits ----
MAX_FILE_BYTES=10485760
MAX_REQUEST_BYTES=12582912
MAX_FILES_PER_VERSION=10
MAX_PDF_PAGES=10
MAX_IMAGE_PIXELS=40000000

# ---- Document policy (PAN is mandatory; other limits are configurable) ----
PAN_POLICY=required
MAX_SALARY_SLIPS=6
REQUIRED_SALARY_SLIPS=1
RETENTION_DAYS_AFTER_DECISION=7

# ---- Worker ----
WORKER_POLL_SECONDS=1
WORKER_LEASE_SECONDS=120
WORKER_HEARTBEAT_SECONDS=15
JOB_MAX_ATTEMPTS=3
RETENTION_SWEEP_MINUTES=60

# ---- Storage (private; never inside a web root) ----
STORAGE_BACKEND=local
STORAGE_DIR=./var/storage
# STORAGE_BACKEND=s3  (requires: uv pip install boto3)
S3_BUCKET=
S3_ENDPOINT_URL=

# ---- Email (leave SMTP_HOST empty in development to use the labelled development mailbox) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@northbridge.example
SMTP_STARTTLS=true

# ---- Telemetry (metadata only) ----
LOG_LEVEL=INFO
LOG_JSON=true
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=northbridge-kyc
